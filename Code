\nsens_rows = []\nfor name, y, xs, target, model, flt in SENS_SPECS:\n    try:\n        data = PART\n        if flt == \"cooks\":\n            _, dd, zz = standardized_fit(PART, y, xs)\n            ck = sm.OLS(zz[y], sm.add_constant(zz[xs])).fit().get_influence().cooks_distance[0]\n            data = PART.loc[dd.index[ck <= 4 / len(dd)]]\n        fit, dd, _ = standardized_fit(data, y, xs, model=model)\n        ci = fit.conf_int().loc[target]\n        sens_rows.append({\"analysis\": name, \"n\": len(dd), \"beta\": fit.params[target], \"ci_low\": ci[0],\n                          \"ci_high\": ci[1], \"p\": fit.pvalues[target]})\n    except (DataError, KeyError, ValueError) as exc:\n        sens_rows.append({\"analysis\": name, \"n\": 0, \"beta\": np.nan, \"ci_low\": np.nan, \"ci_high\": np.nan,\n                          \"p\": np.nan, \"note\": str(exc)})\nSENS = pd.DataFrame(sens_rows)\nsave_table(SENS, \"rq1_sensitivity\")\nprint(SENS.round(3).to_string(index=False))\n\nif RQ1:\n    fig = plt.figure(figsize=(COL2, 4.4), layout=\"constrained\")\n    gs = fig.add_gridspec(2, 2, height_ratios=[1.0, 1.05])\n    ax1, ax2, ax3 = fig.add_subplot(gs[0, 0]), fig.add_subplot(gs[0, 1]), fig.add_subplot(gs[1, :])\n    # (a) standardised coefficients\n    ypos = np.arange(len(coefs))[::-1]\n    for yp, (_, r) in zip(ypos, coefs.iterrows()):\n        hl = r[\"term\"] == RQ1_TARGET\n        col = OI[\"vermillion\"] if hl else \"#333333\"\n        ax1.plot([r[\"ci_low\"], r[\"ci_high\"]], [yp, yp], color=col, lw=1.1)\n        ax1.plot(r[\"beta\"], yp, \"o\", color=col, ms=4 if hl else 3.2)\n    ax1.axvline(0, color=\"#777777\", lw=0.6, ls=(0, (3, 2)))\n    ax1.set_yticks(ypos, [X_LABEL[t] for t in coefs[\"term\"]])\n    ax1.set_xlabel(\"Standardised β (95% CI, HC3)\")\n    ax1.set_title(f\"Model of Stress-2 error (n = {RQ1['n']})\", loc=\"left\")\n    # (b) added-variable plot\n    others = [x for x in RQ1_X if x != RQ1_TARGET]\n    Xo = sm.add_constant(z1[others])\n    ry = sm.OLS(z1[RQ1_Y], Xo).fit().resid\n    rx = sm.OLS(z1[RQ1_TARGET], Xo).fit().resid\n    ax2.scatter(rx, ry, s=10, color=OI[\"blue\"], alpha=0.85, lw=0)\n    gx = np.linspace(rx.min(), rx.max(), 50)\n    ax2.plot(gx, RQ1[\"beta_RB\"] * gx, color=OI[\"vermillion\"], lw=1.1)\n    ax2.set_xlabel(\"Recovery burden | others (z)\")\n    ax2.set_ylabel(\"Stress-2 error | others (z)\")\n    ax2.text(0.03, 0.97, f\"β = {RQ1['beta_RB']:.2f}\\n{fmt_p(RQ1['p_HC3'])}\", transform=ax2.transAxes,\n             va=\"top\", fontsize=6.5)\n    ax2.set_title(\"Added-variable plot\", loc=\"left\")\n    # (c) sensitivity forest\n    sp = SENS.dropna(subset=[\"beta\"]).reset_index(drop=True)\n    yp = np.arange(len(sp))[::-1]\n    for y_, (_, r) in zip(yp, sp.iterrows()):\n        col = OI[\"vermillion\"] if r[\"analysis\"].startswith(\"Primary\") else \"#333333\"\n        ax3.plot([r[\"ci_low\"], r[\"ci_high\"]], [y_, y_], color=col, lw=1.0)\n        ax3.plot(r[\"beta\"], y_, \"s\", color=col, ms=3)\n    ax3.axvline(0, color=\"#777777\", lw=0.6, ls=(0, (3, 2)))\n    ax3.set_yticks(yp, [f\"{a} (n={n})\" for a, n in zip(sp[\"analysis\"], sp[\"n\"])], fontsize=6)\n    ax3.set_xlabel(\"Standardised β for recovery burden\")\n    ax3.set_title(\"Sensitivity analyses\", loc=\"left\")\n    label_panels(fig, (ax1, ax2, ax3))\n    save_fig(fig, \"fig3_rq1_recovery_vs_performance\",\n             \"Figure 3. RQ1. (a) Standardised coefficients of the prespecified model of Stress-2 RESMAN error with HC3 95% CIs. \"\n             \"(b) Added-variable (partial regression) plot for recovery burden. (c) Recovery-burden coefficient across \"\n             \"prespecified sensitivity analyses. Associational estimates; not causal effects.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:20:32.736288Z","iopub.execute_input":"2026-10-12T18:20:32.736734Z","iopub.status.idle":"2026-10-12T18:20:34.536624Z","shell.execute_reply.started":"2026-10-12T18:20:32.73671Z","shell.execute_reply":"2