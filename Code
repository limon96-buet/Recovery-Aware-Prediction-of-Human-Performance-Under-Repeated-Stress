{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":271117},{"sourceType":"datasetVersion","sourceId":11476463}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"cbea84f2","cell_type":"markdown","source":"# Recovery-Aware Prediction of Human Performance Under Repeated Stress\n### A neuroergonomic framework with cross-context validation (PhysioNet · WESAD · SWELL-KW)\n\n**What this notebook does**\n\n| Research question | Data | Analysis |\n|---|---|---|\n| **RQ1** — Is residual physiological deviation during *Recovery 1* associated with RESMAN error during *Stress 2*, after adjusting for prior performance and initial reactivity? | PhysioNet (primary, n ≈ 35) | Standardised OLS with HC3 errors, participant bootstrap, 10 prespecified sensitivity analyses |\n| **RQ2** — Do recovery features improve *out-of-sample* prediction of Stress-2 error? | PhysioNet | Nested leave-one-participant-out (LOSO), three learners, paired bootstrap, permutation test |\n| **RQ3** — How portable are peripheral stress signatures across stressor contexts, and does personal-baseline calibration help? | PhysioNet · WESAD · SWELL-KW | Within- vs cross-dataset classification, uncalibrated vs baseline-calibrated, subject-cluster bootstrap |\n| **RQ4** (exploratory) — Does recovery burden track self-reported resilience (CD-RISC)? | PhysioNet | Spearman correlation with bootstrap CI |\n\n**Kaggle setup (≈ 2 minutes)**\n1. *Add Input* → search **WESAD** (e.g. `orvile/wesad-wearable-stress-affect-detection-dataset`) → Add.\n2. *Add Input* → search **SWELL** (e.g. `qiriro/swell-heart-rate-variability-hrv`) → Add.\n3. PhysioNet: *Settings → Internet → On*. The notebook downloads only the files it needs\n   (MATB-II logs, Empatica E4 CSVs and demographics, ≈ 50 MB rather than 19.1 GB), verifies SHA-256 checksums, and caches them.\n   Alternatively attach the PhysioNet files as a Kaggle dataset; the notebook detects them automatically.\n4. *Run All*. All outputs go to `/kaggle/working/nsr_outputs/` (figures at 600 dpi PNG + vector PDF, CSV tables, JSON summary, log).\n\n**Design principles enforced in code:** participant-level validation only (never random window splits); all tuning,\nimputation and scaling inside training folds; prespecified primary variables; uncertainty reported for every estimate;\ndatasets are never pooled into one training table.","metadata":{}},{"id":"293ac895","cell_type":"code","source":"# ── 1 · Runtime environment ─────────────────────────────────────────────────\n# Thread caps are set *before* NumPy/SciPy/scikit-learn are imported so that\n# joblib's process-level parallelism does not oversubscribe Kaggle's vCPUs.\nimport os\nfor _v in (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\"):\n    os.environ.setdefault(_v, \"1\")\n\nimport gc\nimport hashlib\nimport json\nimport logging\nimport math\nimport pickle\nimport platform\nimport re\nimport sys\nimport time\nimport urllib.request\nimport warnings\nimport zlib\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\nimport numpy as np\nimport pandas as pd\nimport scipy\nfrom scipy import signal as sps\nfrom scipy import stats\nfrom scipy.ndimage import median_filter\n\nimport sklearn\nfrom sklearn.base import clone\nfrom sklearn.ensemble import GradientBoostingRegressor, HistGradientBoostingClassifier\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.linear_model import ElasticNetCV, LogisticRegression, RidgeCV\nfrom sklearn.metrics import (balanced_accuracy_score, confusion_matrix, f1_score,\n                             roc_auc_score, roc_curve)\nfrom sklearn.model_selection import GridSearchCV, GroupKFold, KFold, cross_val_predict\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler\n\nimport statsmodels\nimport statsmodels.api as sm\nfrom statsmodels.stats.diagnostic import het_breuschpagan\nfrom statsmodels.stats.outliers_influence import variance_inflation_factor\n\nfrom joblib import Parallel, delayed\n\nimport matplotlib as mpl\nimport matplotlib.pyplot as plt\nfrom matplotlib import font_manager\nfrom matplotlib.lines import Line2D\nfrom matplotlib.patches import Patch\n\nwarnings.filterwarnings(\"ignore\", category=FutureWarning)\nwarnings.filterwarnings(\"ignore\", category=DeprecationWarning)\nlogging.getLogger(\"matplotlib.font_manager\").setLevel(logging.ERROR)\n\nON_KAGGLE = Path(\"/kaggle/input\").exists()\nVERSIONS = {\n    \"python\": platform.python_version(), \"numpy\": np.__version__, \"pandas\": pd.__version__,\n    \"scipy\": scipy.__version__, \"scikit-learn\": sklearn.__version__,\n    \"statsmodels\": statsmodels.__version__, \"matplotlib\": mpl.__version__,\n}\nprint(f\"Running on Kaggle: {ON_KAGGLE}  |  CPUs: {os.cpu_count()}\")\nprint(\"  \".join(f\"{k} {v}\" for k, v in VERSIONS.items()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:11:50.692542Z","iopub.execute_input":"2026-10-12T18:11:50.692937Z","iopub.status.idle":"2026-10-12T18:11:56.704302Z","shell.execute_reply.started":"2026-10-12T18:11:50.692902Z","shell.execute_reply":"2026-10-12T18:11:56.703644Z"}},"outputs":[{"name":"stdout","text":"Running on Kaggle: True  |  CPUs: 4\npython 3.13.15  numpy 2.1.3  pandas 2.3.3  scipy 1.16.3  scikit-learn 1.6.1  statsmodels 0.15.0  matplotlib 3.10.0\n","output_type":"stream"}],"execution_count":1},{"id":"6c26ec90","cell_type":"code","source":"# ── 2 · Configuration (every analytic choice is declared here, before any data are seen) ──\nQUICK = os.environ.get(\"NSR_QUICK\", \"0\") == \"1\"   # fast smoke-test mode; leave off for the real run\n\n\n@dataclass\nclass Config:\n    # Reproducibility / compute\n    seed: int = 20261012\n    n_jobs: int = -1\n\n    # I/O (environment variables override the Kaggle defaults)\n    input_root: str = os.environ.get(\"NSR_INPUT_ROOT\", \"/kaggle/input\")\n    work_root: str = os.environ.get(\"NSR_WORK_ROOT\", \"/kaggle/working\" if ON_KAGGLE else \"./working\")\n    physionet_dir: Optional[str] = os.environ.get(\"NSR_PHYSIONET_DIR\")\n    wesad_dir: Optional[str] = os.environ.get(\"NSR_WESAD_DIR\")\n    swell_dir: Optional[str] = os.environ.get(\"NSR_SWELL_DIR\")\n    physionet_url: str = \"https://physionet.org/files/neuro-stress-resilience-hci/1.0.0\"\n    allow_download: bool = True\n    download_workers: int = 8\n\n    # PhysioNet protocol (seconds, relative to the E4 Working-Baseline tag)\n    task_phases: Tuple[str, ...] = (\"WB\", \"S1\", \"R1\", \"S2\", \"R2\")\n    phase_len_s: float = 360.0\n    rest_len_s: float = 60.0\n    transition_s: float = 30.0          # excluded at the start of every phase\n    min_phase_coverage: float = 0.80    # minimum valid fraction of a phase\n    matb_sample_period_s: float = 10.0\n\n    # Windowing (RQ3)\n    window_s: float = 60.0\n    min_window_coverage: float = 0.60\n    n_cal_windows: int = 2              # control windows reserved for personal-baseline calibration\n    feature_min_availability: float = 0.80\n\n    # Signal processing\n    hr_source: str = \"bvp\"              # \"bvp\" (harmonised with WESAD) or \"e4_hr\" (on-device HR)\n    e4_acc_units_per_g: float = 64.0\n    eda_invalid_below_us: float = 0.005\n    eda_lowpass_hz: float = 1.0\n    eda_tonic_hz: float = 0.05\n    scr_min_amp_us: float = 0.01\n    bvp_band_hz: Tuple[float, float] = (0.7, 3.5)\n    bvp_peak_prominence: float = 0.5    # in envelope-normalised units\n    ibi_min_s: float = 0.33\n    ibi_max_s: float = 1.50\n    ibi_max_rel_change: float = 0.25\n    hr_grid_hz: float = 4.0\n    max_beat_gap_s: float = 3.0\n    min_rmssd_pairs: int = 20\n    scale_floor_quantile: float = 0.10  # cohort floor on the robust baseline scale\n    traj_bin_s: int = 30\n    motion_robust_z: float = 3.5\n\n    # Inference and training intensity\n    n_boot: int = 5000                  # participant bootstrap (RQ1, RQ2, RQ4)\n    n_boot_cls: int = 2000              # subject-cluster bootstrap (RQ3)\n    n_perm: int = 2000                  # permutation test (RQ2)\n    ridge_alphas: Tuple[float, ...] = tuple(np.logspace(-3, 3, 61))\n    enet_alphas: Tuple[float, ...] = tuple(np.logspace(-4, 1, 100))\n    enet_l1_ratios: Tuple[float, ...] = (0.1, 0.3, 0.5, 0.7, 0.9, 0.95, 1.0)\n    rq2_run_gbr: bool = True\n    gbr_grid: Dict[str, list] = field(default_factory=lambda: {\n        \"n_estimators\": [300, 800], \"learning_rate\": [0.01, 0.03],\n        \"max_depth\": [1, 2], \"min_samples_leaf\": [3, 5], \"subsample\": [0.7]})\n    inner_folds: int = 5\n    outer_folds: int = 5\n    logreg_C: Tuple[float, ...] = tuple(np.logspace(-3, 3, 25))\n    hgb_max_iter: int = 500\n    hgb_grid: Dict[str, list] = field(default_factory=lambda: {\n        \"clf__learning_rate\": [0.03, 0.1], \"clf__max_depth\": [2, 3],\n        \"clf__min_samples_leaf\": [20], \"clf__l2_regularization\": [0.0, 1.0]})\n    rq3_models: Tuple[str, ...] = (\"logreg\", \"hgb\")\n    swell_max_rows_per_cell: int = 200\n\n    # Figures\n    fig_dpi: int = 600\n    fig_formats: Tuple[str, ...] = (\"png\", \"pdf\")   # add \"tiff\" if a journal requires it\n\n\ncfg = Config()\nif QUICK:\n    cfg.n_boot, cfg.n_boot_cls, cfg.n_perm = 200, 100, 40\n    cfg.gbr_grid = {\"n_estimators\": [100], \"learning_rate\": [0.05], \"max_depth\": [1, 2],\n                    \"min_samples_leaf\": [3], \"subsample\": [0.7]}\n    cfg.hgb_max_iter = 100\n    cfg.hgb_grid = {\"clf__learning_rate\": [0.1], \"clf__max_depth\": [2],\n                    \"clf__min_samples_leaf\": [20], \"clf__l2_regularization\": [0.0]}\n    cfg.logreg_C = tuple(np.logspace(-2, 2, 5))\n\nassert cfg.hr_source in (\"bvp\", \"e4_hr\"), \"hr_source must be 'bvp' or 'e4_hr'\"\nTASK_PHASES = list(cfg.task_phases)\nN_TASK = len(TASK_PHASES)\nprint(f\"QUICK mode: {QUICK}  |  bootstrap={cfg.n_boot}  cluster-bootstrap={cfg.n_boot_cls}  permutations={cfg.n_perm}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:12:03.79055Z","iopub.execute_input":"2026-10-12T18:12:03.790934Z","iopub.status.idle":"2026-10-12T18:12:03.808549Z","shell.execute_reply.started":"2026-10-12T18:12:03.790908Z","shell.execute_reply":"2026-10-12T18:12:03.807659Z"}},"outputs":[{"name":"stdout","text":"QUICK mode: False  |  bootstrap=5000  cluster-bootstrap=2000  permutations=2000\n","output_type":"stream"}],"execution_count":2},{"id":"37ef8d66","cell_type":"code","source":"# ── 3 · Output folders, logging and small statistical helpers ───────────────\nOUT = Path(cfg.work_root) / \"nsr_outputs\"\nFIG_DIR, TAB_DIR, CACHE_DIR, LOG_DIR = (OUT / d for d in (\"figures\", \"tables\", \"cache\", \"logs\"))\nfor _d in (FIG_DIR, TAB_DIR, CACHE_DIR, LOG_DIR):\n    _d.mkdir(parents=True, exist_ok=True)\n\nLOG = logging.getLogger(\"nsr\")\nLOG.handlers.clear()\nLOG.setLevel(logging.INFO)\nLOG.propagate = False\n_fmt = logging.Formatter(\"%(asctime)s | %(levelname)-7s | %(message)s\", \"%H:%M:%S\")\nfor _h in (logging.StreamHandler(sys.stdout), logging.FileHandler(LOG_DIR / \"run.log\", mode=\"w\")):\n    _h.setFormatter(_fmt)\n    LOG.addHandler(_h)\n\nRESULTS: Dict[str, object] = {\"config\": {k: (list(v) if isinstance(v, tuple) else v)\n                                         for k, v in asdict(cfg).items()},\n                              \"versions\": VERSIONS}\n\n\nclass DataError(RuntimeError):\n    \"\"\"Raised when a participant's data fail a prespecified quality rule.\"\"\"\n\n\nclass Timer:\n    def __init__(self, label: str):\n        self.label = label\n\n    def __enter__(self):\n        self.t0 = time.perf_counter()\n        LOG.info(f\"▶ {self.label}\")\n        return self\n\n    def __exit__(self, *exc):\n        LOG.info(f\"■ {self.label} — {time.perf_counter() - self.t0:,.1f} s\")\n        return False\n\n\ndef rng_for(tag: str) -> np.random.Generator:\n    \"\"\"Independent, reproducible random stream for each named analysis.\"\"\"\n    return np.random.default_rng([cfg.seed, zlib.crc32(tag.encode())])\n\n\ndef nanmean_safe(x) -> float:\n    x = np.asarray(x, float)\n    return float(np.nanmean(x)) if np.isfinite(x).any() else np.nan\n\n\ndef robust_scale(x) -> float:\n    \"\"\"Normal-consistent median absolute deviation.\"\"\"\n    x = np.asarray(x, float)\n    x = x[np.isfinite(x)]\n    if x.size < 2:\n        return np.nan\n    return float(1.4826 * np.median(np.abs(x - np.median(x))))\n\n\ndef theil_slope(x, y) -> float:\n    x, y = np.asarray(x, float), np.asarray(y, float)\n    m = np.isfinite(x) & np.isfinite(y)\n    if m.sum() < 3 or np.ptp(x[m]) == 0:\n        return np.nan\n    return float(stats.theilslopes(y[m], x[m])[0])\n\n\ndef pct_ci(a, alpha: float = 0.05) -> Tuple[float, float]:\n    a = np.asarray(a, float)\n    a = a[np.isfinite(a)]\n    if a.size < 10:\n        return (np.nan, np.nan)\n    return (float(np.quantile(a, alpha / 2)), float(np.quantile(a, 1 - alpha / 2)))\n\n\ndef fmt_ci(est, lo, hi, nd: int = 2) -> str:\n    if not np.isfinite(est):\n        return \"NA\"\n    return f\"{est:.{nd}f} [{lo:.{nd}f}, {hi:.{nd}f}]\"\n\n\ndef fmt_p(p) -> str:\n    \"\"\"'p < 0.001' or 'p = 0.012' — ready to drop into text.\"\"\"\n    if p is None or not np.isfinite(p):\n        return \"p = NA\"\n    return \"p < 0.001\" if p < 0.001 else f\"p = {p:.3f}\"\n\n\ndef save_table(df: pd.DataFrame, name: str, index: bool = False) -> Path:\n    path = TAB_DIR / f\"{name}.csv\"\n    df.to_csv(path, index=index)\n    LOG.info(f\"table → {path.name} ({len(df)} rows)\")\n    return path\n\n\nLOG.info(f\"Outputs: {OUT.resolve()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:12:12.976603Z","iopub.execute_input":"2026-10-12T18:12:12.977438Z","iopub.status.idle":"2026-10-12T18:12:12.993966Z","shell.execute_reply.started":"2026-10-12T18:12:12.97741Z","shell.execute_reply":"2026-10-12T18:12:12.993105Z"}},"outputs":[{"name":"stdout","text":"18:12:12 | INFO    | Outputs: /kaggle/working/nsr_outputs\n","output_type":"stream"}],"execution_count":3},{"id":"a1ef0efc","cell_type":"code","source":"# ── 4 · Journal figure style (Okabe–Ito colour-blind-safe palette, 600 dpi) ──\nOI = dict(black=\"#000000\", orange=\"#E69F00\", sky=\"#56B4E9\", green=\"#009E73\", yellow=\"#F0E442\",\n          blue=\"#0072B2\", vermillion=\"#D55E00\", purple=\"#CC79A7\", grey=\"#8C8C8C\")\nPHASE_FILL = {\"Rest\": \"#FFFFFF\", \"WB\": \"#EEEEEE\", \"S1\": \"#FBE3D6\", \"R1\": \"#DCEBF7\",\n              \"S2\": \"#FBE3D6\", \"R2\": \"#DCEBF7\"}\nPHASE_DOT = {\"WB\": OI[\"grey\"], \"S1\": OI[\"vermillion\"], \"R1\": OI[\"blue\"],\n             \"S2\": OI[\"vermillion\"], \"R2\": OI[\"blue\"]}\nPHASE_LABEL = {\"Rest\": \"Rest\", \"WB\": \"Working\\nbaseline\", \"S1\": \"Stress 1\", \"R1\": \"Recovery 1\",\n               \"S2\": \"Stress 2\", \"R2\": \"Recovery 2\"}\nDATASET_COLOR = {\"PhysioNet\": OI[\"blue\"], \"WESAD\": OI[\"orange\"], \"SWELL\": OI[\"green\"]}\nMM = 1 / 25.4\nCOL1, COL15, COL2 = 89 * MM, 136 * MM, 183 * MM     # single, 1.5 and double column widths\n\n\ndef _pick_font() -> str:\n    available = {f.name for f in font_manager.fontManager.ttflist}\n    for name in (\"Arial\", \"Helvetica\", \"Liberation Sans\", \"DejaVu Sans\"):\n        if name in available:\n            return name\n    return \"sans-serif\"\n\n\nFONT = _pick_font()\nmpl.rcParams.update({\n    \"figure.dpi\": 110, \"savefig.dpi\": cfg.fig_dpi, \"figure.facecolor\": \"white\",\n    \"font.family\": \"sans-serif\", \"font.sans-serif\": [FONT, \"DejaVu Sans\"],\n    \"font.size\": 7.5, \"axes.titlesize\": 8, \"axes.labelsize\": 7.5, \"xtick.labelsize\": 6.5,\n    \"ytick.labelsize\": 6.5, \"legend.fontsize\": 6.5, \"axes.titleweight\": \"bold\",\n    \"axes.linewidth\": 0.6, \"xtick.major.width\": 0.6, \"ytick.major.width\": 0.6,\n    \"xtick.major.size\": 2.5, \"ytick.major.size\": 2.5, \"xtick.direction\": \"out\", \"ytick.direction\": \"out\",\n    \"axes.spines.top\": False, \"axes.spines.right\": False, \"legend.frameon\": False,\n    \"lines.linewidth\": 1.0, \"lines.markersize\": 3.5, \"pdf.fonttype\": 42, \"ps.fonttype\": 42,\n    \"svg.fonttype\": \"none\", \"axes.unicode_minus\": False,\n})\nFIGURES: List[Dict[str, str]] = []\n\n\ndef label_panels(fig, axes, letters: str = \"abcdefgh\") -> None:\n    \"\"\"Bold panel letters at the left edge of each axes' tight bounding box (so long tick labels never collide),\n    vertically aligned across every panel in the same grid row. The layout is frozen afterwards so the\n    letters cannot drift when the figure is re-laid-out at save time.\"\"\"\n    fig.canvas.draw()\n    renderer, inv = fig.canvas.get_renderer(), fig.transFigure.inverted()\n    boxes = [ax.get_tightbbox(renderer).transformed(inv) for ax in axes]\n\n    def row_of(ax):\n        ss = ax.get_subplotspec() if hasattr(ax, \"get_subplotspec\") else None\n        return ss.rowspan.start if ss is not None else round(ax.get_position().y1, 2)\n\n    rows = [row_of(ax) for ax in axes]\n    for ax, bb, row, lab in zip(axes, boxes, rows, letters):\n        top = max(b.y1 for b, r in zip(boxes, rows) if r == row)\n        fig.text(bb.x0, top + 0.004, lab, fontsize=9, fontweight=\"bold\", ha=\"left\", va=\"bottom\")\n    try:\n        fig.set_layout_engine(\"none\")\n    except Exception:                       # matplotlib < 3.6\n        fig.set_constrained_layout(False)\n\n\ndef save_fig(fig, stem: str, caption: str) -> None:\n    \"\"\"Save every requested format at the configured resolution and record a caption.\"\"\"\n    paths = []\n    for ext in cfg.fig_formats:\n        path = FIG_DIR / f\"{stem}.{ext}\"\n        kwargs = dict(dpi=cfg.fig_dpi, bbox_inches=\"tight\", pad_inches=0.03, facecolor=\"white\")\n        if ext in (\"tif\", \"tiff\"):\n            kwargs[\"pil_kwargs\"] = {\"compression\": \"tiff_lzw\"}\n        fig.savefig(path, **kwargs)\n        paths.append(path.name)\n    FIGURES.append({\"stem\": stem, \"files\": \", \".join(paths), \"caption\": caption})\n    LOG.info(f\"figure → {stem} ({', '.join(cfg.fig_formats)} @ {cfg.fig_dpi} dpi)\")\n    plt.show()\n    plt.close(fig)\n\n\nprint(f\"Figure font: {FONT}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:12:23.660753Z","iopub.execute_input":"2026-10-12T18:12:23.661228Z","iopub.status.idle":"2026-10-12T18:12:23.675415Z","shell.execute_reply.started":"2026-10-12T18:12:23.661206Z","shell.execute_reply":"2026-10-12T18:12:23.674594Z"}},"outputs":[{"name":"stdout","text":"Figure font: Liberation Sans\n","output_type":"stream"}],"execution_count":4},{"id":"87ba1419","cell_type":"markdown","source":"## Part A — Data acquisition\nPhysioNet is the primary cohort and is required. WESAD and SWELL-KW are optional external contexts for RQ3;\nif either is not attached, RQ3 runs with whatever is available and says so explicitly.","metadata":{}},{"id":"632aff0a","cell_type":"code","source":"# ── 5 · PhysioNet: locate an attached copy or download the minimal subset ───\nPHYSIONET_SUBJECTS = [f\"p{i:02d}\" for i in range(1, 38) if i not in (14, 23)]   # p14, p23 excluded by curators\nE4_FILES = (\"EDA.csv\", \"BVP.csv\", \"HR.csv\", \"ACC.csv\", \"tags.csv\")\n\n\ndef physionet_relpaths() -> List[str]:\n    rel = [\"demographicCDrisk.csv\"]\n    rel += [f\"MATB-II/{s}resman.csv\" for s in PHYSIONET_SUBJECTS]\n    rel += [f\"PPG/{s}/{f}\" for s in PHYSIONET_SUBJECTS for f in E4_FILES]\n    return rel\n\n\ndef is_physionet_root(p: Optional[Path]) -> bool:\n    return (p is not None and (p / \"demographicCDrisk.csv\").is_file()\n            and (p / \"MATB-II\").is_dir() and (p / \"PPG\").is_dir())\n\n\ndef first_match(root: Path, pattern: str) -> Optional[Path]:\n    if not root.exists():\n        return None\n    return next(iter(sorted(root.rglob(pattern))), None)\n\n\ndef http_get(url: str, timeout: int = 90) -> bytes:\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"nsr-kaggle-notebook/1.0\"})\n    with urllib.request.urlopen(req, timeout=timeout) as resp:\n        return resp.read()\n\n\ndef parse_sha256sums(text: str) -> Dict[str, str]:\n    sums = {}\n    for line in text.splitlines():\n        parts = line.strip().split(None, 1)\n        if len(parts) == 2:\n            rel = parts[1].strip().lstrip(\"*\")\n            sums[rel[2:] if rel.startswith(\"./\") else rel] = parts[0].lower()\n    return sums\n\n\ndef sha256_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef download_one(rel: str, dest_root: Path, expected: Optional[str], retries: int = 4) -> Optional[str]:\n    dest = dest_root / rel\n    dest.parent.mkdir(parents=True, exist_ok=True)\n    for attempt in range(1, retries + 1):\n        try:\n            data = http_get(f\"{cfg.physionet_url}/{rel}\")\n            if expected and hashlib.sha256(data).hexdigest() != expected:\n                raise IOError(\"SHA-256 mismatch\")\n            tmp = dest.with_name(dest.name + \".part\")\n            tmp.write_bytes(data)\n            tmp.replace(dest)\n            return None\n        except Exception as exc:                      # network errors are retried with back-off\n            if attempt == retries:\n                return f\"{rel}: {exc}\"\n            time.sleep(2 ** attempt)\n    return None\n\n\ndef fetch_physionet_subset(dest: Path) -> None:\n    dest.mkdir(parents=True, exist_ok=True)\n    sums_path = dest / \"SHA256SUMS.txt\"\n    try:\n        sums_path.write_bytes(http_get(f\"{cfg.physionet_url}/SHA256SUMS.txt\"))\n    except Exception as exc:\n        if not sums_path.is_file():\n            raise RuntimeError(\n                \"Cannot reach PhysioNet. On Kaggle open the right-hand panel → Settings → Internet → On, \"\n                \"or attach the PhysioNet files as a dataset and set NSR_PHYSIONET_DIR.\\n\"\n                f\"Underlying error: {exc}\") from exc\n    sums = parse_sha256sums(sums_path.read_text())\n    todo = []\n    for rel in physionet_relpaths():\n        path, expected = dest / rel, sums.get(rel)\n        if not (path.is_file() and path.stat().st_size > 0 and (expected is None or sha256_file(path) == expected)):\n            todo.append(rel)\n    LOG.info(f\"PhysioNet subset: {len(physionet_relpaths()) - len(todo)} cached, {len(todo)} to download\")\n    failures = []\n    with ThreadPoolExecutor(max_workers=cfg.download_workers) as ex:\n        futures = [ex.submit(download_one, rel, dest, sums.get(rel)) for rel in todo]\n        for fut in as_completed(futures):\n            err = fut.result()\n            if err:\n                failures.append(err)\n    if failures:\n        LOG.warning(f\"{len(failures)} files failed to download; affected participants will be excluded:\\n  \"\n                    + \"\\n  \".join(failures[:10]))\n\n\ndef resolve_physionet_root() -> Tuple[Path, str]:\n    if cfg.physionet_dir and is_physionet_root(Path(cfg.physionet_dir)):\n        return Path(cfg.physionet_dir), \"attached (NSR_PHYSIONET_DIR)\"\n    hit = first_match(Path(cfg.input_root), \"demographicCDrisk.csv\")\n    if hit is not None and is_physionet_root(hit.parent):\n        return hit.parent, \"attached Kaggle dataset\"\n    if not cfg.allow_download:\n        raise RuntimeError(\"PhysioNet data not found and downloading is disabled.\")\n    dest = CACHE_DIR / \"physionet\"\n    fetch_physionet_subset(dest)\n    if not is_physionet_root(dest):\n        raise RuntimeError(\"PhysioNet download incomplete — see the warnings above.\")\n    return dest, \"downloaded subset (checksum-verified)\"\n\n\nwith Timer(\"Locate PhysioNet\"):\n    PN_ROOT, PN_SOURCE = resolve_physionet_root()\nLOG.info(f\"PhysioNet root: {PN_ROOT}  [{PN_SOURCE}]\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:12:45.743644Z","iopub.execute_input":"2026-10-12T18:12:45.743897Z","iopub.status.idle":"2026-10-12T18:16:11.611121Z","shell.execute_reply.started":"2026-10-12T18:12:45.743879Z","shell.execute_reply":"2026-10-12T18:16:11.610365Z"}},"outputs":[{"name":"stdout","text":"18:12:45 | INFO    | ▶ Locate PhysioNet\n18:12:46 | INFO    | PhysioNet subset: 0 cached, 211 to download\n18:16:11 | INFO    | ■ Locate PhysioNet — 205.8 s\n18:16:11 | INFO    | PhysioNet root: /kaggle/working/nsr_outputs/cache/physionet  [downloaded subset (checksum-verified)]\n","output_type":"stream"}],"execution_count":5},{"id":"60d3d0af","cell_type":"code","source":"# ── 6 · WESAD and SWELL-KW: discover attached Kaggle inputs ─────────────────\ndef resolve_wesad_pkls() -> List[Path]:\n    root = Path(cfg.wesad_dir) if cfg.wesad_dir else Path(cfg.input_root)\n    if not root.exists():\n        return []\n    found: Dict[str, Path] = {}\n    for p in sorted(root.rglob(\"S*.pkl\")):\n        if re.fullmatch(r\"S\\d+\\.pkl\", p.name) and p.stem not in found:   # de-duplicate nested copies\n            found[p.stem] = p\n    return [found[k] for k in sorted(found, key=lambda s: int(s[1:]))]\n\n\ndef resolve_swell_csvs() -> List[Path]:\n    root = Path(cfg.swell_dir) if cfg.swell_dir else Path(cfg.input_root)\n    if not root.exists():\n        return []\n    hits = []\n    for p in sorted(root.rglob(\"*.csv\")):\n        if is_physionet_root(p.parent) or \"PPG\" in p.parts or \"MATB-II\" in p.parts:\n            continue\n        try:\n            cols = {str(c).strip().lower() for c in pd.read_csv(p, nrows=0).columns}\n        except Exception:\n            continue\n        if \"condition\" in cols and ({\"hr\", \"rmssd\", \"scl\"} & cols):\n            hits.append(p)\n    return hits\n\n\nWESAD_PKLS = resolve_wesad_pkls()\nSWELL_CSVS = resolve_swell_csvs()\nLOG.info(f\"WESAD subjects found: {len(WESAD_PKLS)}  {[p.stem for p in WESAD_PKLS]}\")\nLOG.info(f\"SWELL-KW feature tables found: {len(SWELL_CSVS)}  {[p.name for p in SWELL_CSVS]}\")\nif not WESAD_PKLS:\n    LOG.warning(\"WESAD not attached — RQ3 will run without it.\")\nif not SWELL_CSVS:\n    LOG.warning(\"SWELL-KW not attached — RQ3 will run without it.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:17:53.889299Z","iopub.execute_input":"2026-10-12T18:17:53.889769Z","iopub.status.idle":"2026-10-12T18:17:55.3459Z","shell.execute_reply.started":"2026-10-12T18:17:53.889744Z","shell.execute_reply":"2026-10-12T18:17:55.345329Z"}},"outputs":[{"name":"stdout","text":"18:17:55 | INFO    | WESAD subjects found: 15  ['S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8', 'S9', 'S10', 'S11', 'S13', 'S14', 'S15', 'S16', 'S17']\n18:17:55 | INFO    | SWELL-KW feature tables found: 4  ['test.csv', 'train.csv', 'test.csv', 'train.csv']\n","output_type":"stream"}],"execution_count":6},{"id":"cc178253","cell_type":"markdown","source":"## Part B — Readers and signal processing\nOne processing chain is applied to every Empatica-E4 wrist recording (PhysioNet and WESAD wrist), so features are\ncomputed identically across datasets. Heart rate is derived from the BVP waveform with the same beat detector in\nboth datasets; the on-device E4 heart rate is kept for a sensitivity analysis.","metadata":{}},{"id":"87ace413","cell_type":"code","source":"# ── 7 · File readers (Empatica E4 export format and MATB-II RESMAN logs) ────\ndef read_e4_channel(path: Path) -> Tuple[float, float, np.ndarray]:\n    \"\"\"E4 CSV: row 0 = session start (Unix UTC), row 1 = sampling rate (Hz), then samples.\"\"\"\n    raw = pd.read_csv(path, header=None, skipinitialspace=True)\n    if raw.shape[0] < 3:\n        raise DataError(f\"{path.name}: fewer than three rows\")\n    start, fs = float(raw.iat[0, 0]), float(raw.iat[1, 0])\n    if not (np.isfinite(start) and np.isfinite(fs) and fs > 0):\n        raise DataError(f\"{path.name}: invalid header (start={start}, fs={fs})\")\n    data = raw.iloc[2:].apply(pd.to_numeric, errors=\"coerce\").to_numpy(dtype=float)\n    return start, fs, data\n\n\ndef read_e4_tags(path: Path) -> np.ndarray:\n    if not path.is_file() or path.stat().st_size == 0:\n        return np.array([])\n    try:\n        raw = pd.read_csv(path, header=None)\n    except pd.errors.EmptyDataError:\n        return np.array([])\n    return np.sort(pd.to_numeric(raw.iloc[:, 0], errors=\"coerce\").dropna().to_numpy(float))\n\n\n_ELAPSED_RE = re.compile(r\"^\\s*(?:(\\d+):)?(\\d+):(\\d+(?:\\.\\d+)?)\\s*$\")\n\n\ndef parse_elapsed(value) -> float:\n    \"\"\"'MM:SS.s' or 'HH:MM:SS.s' (as written by MATB-II) → seconds.\"\"\"\n    if isinstance(value, (int, float, np.integer, np.floating)):\n        return float(value)\n    s = str(value).strip().lstrip(\"\\ufeff\")\n    m = _ELAPSED_RE.match(s)\n    if m:\n        return int(m.group(1) or 0) * 3600 + int(m.group(2)) * 60 + float(m.group(3))\n    try:\n        return float(s)\n    except ValueError:\n        return np.nan\n\n\ndef read_matb(path: Path) -> pd.DataFrame:\n    df = pd.read_csv(path, encoding=\"utf-8-sig\")\n    df.columns = [str(c).strip().lstrip(\"\\ufeff\").upper() for c in df.columns]\n    missing = {\"ELAPSED_TIME\", \"DIFF_A\", \"DIFF_B\"} - set(df.columns)\n    if missing:\n        raise DataError(f\"{path.name}: missing columns {sorted(missing)}\")\n    df[\"t_s\"] = df[\"ELAPSED_TIME\"].map(parse_elapsed)\n    for c in (\"DIFF_A\", \"DIFF_B\"):\n        df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n    df = df.dropna(subset=[\"t_s\", \"DIFF_A\", \"DIFF_B\"]).sort_values(\"t_s\").reset_index(drop=True)\n    df[\"abs_err\"] = 0.5 * (df[\"DIFF_A\"].abs() + df[\"DIFF_B\"].abs())\n    # Each log row summarises the preceding 10-s interval, so its centre (t − 5 s) decides the phase;\n    # this makes the assignment robust to the ±0.1 s logging jitter visible in the raw files.\n    k = np.floor((df[\"t_s\"].to_numpy() - cfg.matb_sample_period_s / 2) / cfg.phase_len_s).astype(int)\n    df[\"phase\"] = [TASK_PHASES[i] if 0 <= i < N_TASK else None for i in k]\n    return df\n\n\ndef matb_performance(df: pd.DataFrame) -> Dict[str, float]:\n    expected = cfg.phase_len_s / cfg.matb_sample_period_s\n    out = {}\n    for ph in TASK_PHASES:\n        seg = df.loc[df[\"phase\"] == ph, \"abs_err\"]\n        out[f\"perf_{ph}\"] = float(seg.mean()) if len(seg) >= 0.8 * expected else np.nan\n        out[f\"n_matb_{ph}\"] = int(len(seg))\n    return out","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:18:15.005756Z","iopub.execute_input":"2026-10-12T18:18:15.006302Z","iopub.status.idle":"2026-10-12T18:18:15.018873Z","shell.execute_reply.started":"2026-10-12T18:18:15.006275Z","shell.execute_reply":"2026-10-12T18:18:15.018234Z"}},"outputs":[],"execution_count":8},{"id":"4827a57f","cell_type":"code","source":"# ── 8 · Signal processing core ──────────────────────────────────────────────\nFEATURE_POOL = (\"hr_mean\", \"hr_std\", \"rmssd_ms\", \"eda_tonic_mean\", \"eda_tonic_slope\", \"scr_rate\")\nFEATURE_LABEL = {\"hr_mean\": \"HR mean\", \"hr_std\": \"HR SD\", \"rmssd_ms\": \"RMSSD\", \"eda_tonic_mean\": \"Tonic EDA\",\n                 \"eda_tonic_slope\": \"Tonic EDA slope\", \"scr_rate\": \"SCR rate\"}\n\n\ndef _sosfiltfilt(sos: np.ndarray, x: np.ndarray) -> np.ndarray:\n    if x.size <= 3 * (2 * sos.shape[0] + 1):\n        return np.full(x.shape, np.nan)\n    return sps.sosfiltfilt(sos, x)\n\n\ndef fill_invalid(x: np.ndarray, valid: np.ndarray) -> np.ndarray:\n    \"\"\"Linear interpolation across invalid samples (for filtering only — they stay masked for features).\"\"\"\n    x = np.asarray(x, float).copy()\n    if valid.all():\n        return x\n    if valid.sum() < 2:\n        return np.full(x.shape, np.nan)\n    idx = np.arange(x.size)\n    x[~valid] = np.interp(idx[~valid], idx[valid], x[valid])\n    return x\n\n\ndef process_eda(x: np.ndarray, fs: float):\n    \"\"\"Low-pass, tonic/phasic split and SCR detection. Returns tonic, valid mask, SCR indices, SCR amplitudes.\"\"\"\n    x = np.asarray(x, float).ravel()\n    valid = np.isfinite(x) & (x > cfg.eda_invalid_below_us)\n    if valid.sum() < 10 * fs:\n        nan = np.full(x.shape, np.nan)\n        return nan, valid & False, np.array([], int), np.array([])\n    xf = fill_invalid(x, valid)\n    lp = _sosfiltfilt(sps.butter(4, min(cfg.eda_lowpass_hz, 0.45 * fs), \"lowpass\", fs=fs, output=\"sos\"), xf)\n    tonic = _sosfiltfilt(sps.butter(2, cfg.eda_tonic_hz, \"lowpass\", fs=fs, output=\"sos\"), lp)\n    phasic = lp - tonic\n    if not np.isfinite(phasic).any():\n        return tonic, valid, np.array([], int), np.array([])\n    peaks, props = sps.find_peaks(np.nan_to_num(phasic), prominence=cfg.scr_min_amp_us,\n                                  distance=max(1, int(round(fs))))\n    keep = valid[peaks]\n    return tonic, valid, peaks[keep], props[\"prominences\"][keep]\n\n\ndef detect_beats(bvp: np.ndarray, fs: float):\n    \"\"\"Band-pass BVP, envelope-normalise, pick systolic peaks, then apply physiological IBI rules.\"\"\"\n    empty = (np.array([]), np.array([]), np.array([], bool))\n    x = np.asarray(bvp, float).ravel()\n    valid = np.isfinite(x)\n    if valid.sum() < 10 * fs:\n        return empty\n    x = fill_invalid(x, valid)\n    lo, hi = cfg.bvp_band_hz\n    y = _sosfiltfilt(sps.butter(3, [lo, min(hi, 0.45 * fs)], \"bandpass\", fs=fs, output=\"sos\"), x)\n    if not np.isfinite(y).any():\n        return empty\n    env = median_filter(np.abs(y), size=max(3, int(5 * fs)), mode=\"nearest\") + 1e-12\n    peaks, _ = sps.find_peaks(y / env, distance=max(1, int(cfg.ibi_min_s * fs)),\n                              prominence=cfg.bvp_peak_prominence)\n    peaks = peaks[valid[peaks]]\n    if peaks.size < 3:\n        return empty\n    bt = peaks / fs\n    ibi, t_beat = np.diff(bt), bt[1:]\n    ok = (ibi >= cfg.ibi_min_s) & (ibi <= cfg.ibi_max_s)\n    local_med = (pd.Series(np.where(ok, ibi, np.nan))\n                 .rolling(11, center=True, min_periods=3).median().to_numpy())\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        ok &= np.abs(ibi / local_med - 1.0) <= cfg.ibi_max_rel_change\n    return t_beat, ibi, ok\n\n\ndef beats_to_hr(t_beat, ibi, ok, t_lo: float, t_hi: float):\n    \"\"\"Accepted beats → evenly sampled HR; samples far from any accepted beat are set to NaN.\"\"\"\n    grid = np.arange(t_lo, t_hi, 1.0 / cfg.hr_grid_hz)\n    if ok.sum() < 3:\n        return grid, np.full(grid.size, np.nan)\n    tb, hb = t_beat[ok], 60.0 / ibi[ok]\n    hr = np.interp(grid, tb, hb, left=np.nan, right=np.nan)\n    pos = np.searchsorted(tb, grid)\n    prev = tb[np.clip(pos - 1, 0, tb.size - 1)]\n    nxt = tb[np.clip(pos, 0, tb.size - 1)]\n    hr[np.minimum(np.abs(grid - prev), np.abs(nxt - grid)) > cfg.max_beat_gap_s] = np.nan\n    return grid, hr\n\n\ndef acc_dynamic(acc: np.ndarray, fs: float) -> np.ndarray:\n    a = np.asarray(acc, float)\n    a = (a[:, None] if a.ndim == 1 else a[:, :3]) / cfg.e4_acc_units_per_g\n    mag = np.sqrt(np.nansum(a ** 2, axis=1))\n    return np.abs(mag - median_filter(mag, size=max(3, int(fs)), mode=\"nearest\"))\n\n\n@dataclass\nclass SubjectSignals:\n    dataset: str\n    subject: str\n    eda_t: np.ndarray\n    eda_tonic: np.ndarray\n    eda_valid: np.ndarray\n    eda_fs: float\n    scr_t: np.ndarray\n    scr_amp: np.ndarray\n    beat_t: np.ndarray\n    ibi: np.ndarray\n    beat_ok: np.ndarray\n    hr_t: np.ndarray\n    hr: np.ndarray\n    acc_t: np.ndarray\n    acc_dyn: np.ndarray\n    hr_dev_t: Optional[np.ndarray] = None    # on-device (E4) heart rate, sensitivity analysis only\n    hr_dev: Optional[np.ndarray] = None\n\n\ndef _crop(x: np.ndarray, fs: float, t0: float, lo: float, hi: float):\n    i0 = int(max(0, math.ceil((lo - t0) * fs)))\n    i1 = int(min(x.shape[0], math.floor((hi - t0) * fs)))\n    return (x[:0], t0) if i1 <= i0 else (x[i0:i1], t0 + i0 / fs)\n\n\ndef build_signals(dataset: str, subject: str, eda, eda_fs, eda_t0, bvp, bvp_fs, bvp_t0,\n                  acc, acc_fs, acc_t0, crop=None, hr_dev=None, hr_dev_fs=None, hr_dev_t0=None) -> SubjectSignals:\n    eda = np.asarray(eda, float).ravel()\n    bvp = np.asarray(bvp, float).ravel()\n    acc = np.asarray(acc, float)\n    if crop is not None:\n        eda, eda_t0 = _crop(eda, eda_fs, eda_t0, *crop)\n        bvp, bvp_t0 = _crop(bvp, bvp_fs, bvp_t0, *crop)\n        acc, acc_t0 = _crop(acc, acc_fs, acc_t0, *crop)\n        if hr_dev is not None:\n            hr_dev, hr_dev_t0 = _crop(np.asarray(hr_dev, float).ravel(), hr_dev_fs, hr_dev_t0, *crop)\n    tonic, valid, scr_idx, scr_amp = process_eda(eda, eda_fs)\n    eda_t = eda_t0 + np.arange(eda.size) / eda_fs\n    t_beat, ibi, ok = detect_beats(bvp, bvp_fs)\n    t_beat = t_beat + bvp_t0\n    hr_t, hr = beats_to_hr(t_beat, ibi, ok, bvp_t0, bvp_t0 + bvp.size / bvp_fs)\n    dyn = acc_dynamic(acc, acc_fs) if acc.size else np.array([])\n    sig = SubjectSignals(dataset, subject, eda_t, tonic, valid, float(eda_fs), eda_t[scr_idx], scr_amp,\n                         t_beat, ibi, ok, hr_t, hr, acc_t0 + np.arange(dyn.size) / acc_fs, dyn)\n    if hr_dev is not None and hr_dev.size:\n        hd = np.where(hr_dev > 0, hr_dev, np.nan).astype(float)\n        sig.hr_dev_t, sig.hr_dev = hr_dev_t0 + np.arange(hd.size) / hr_dev_fs, hd\n    return sig\n\n\ndef window_features(s: SubjectSignals, t0: float, t1: float) -> Dict[str, float]:\n    \"\"\"Identical feature definitions for every dataset that provides raw wrist signals.\"\"\"\n    w = t1 - t0\n    f: Dict[str, float] = {k: np.nan for k in FEATURE_POOL}\n    m = (s.eda_t >= t0) & (s.eda_t < t1)\n    v = m & s.eda_valid & np.isfinite(s.eda_tonic)\n    f[\"cov_eda\"] = v.sum() / max(1, int(round(w * s.eda_fs)))\n    if f[\"cov_eda\"] >= cfg.min_window_coverage:\n        tt, xx = s.eda_t[v], s.eda_tonic[v]\n        f[\"eda_tonic_mean\"] = float(np.mean(xx))\n        f[\"eda_tonic_slope\"] = float(np.polyfit((tt - t0) / 60.0, xx, 1)[0]) if xx.size >= 3 else np.nan\n        f[\"scr_rate\"] = float(((s.scr_t >= t0) & (s.scr_t < t1)).sum() / (w / 60.0))\n    fin = (s.hr_t >= t0) & (s.hr_t < t1) & np.isfinite(s.hr)\n    f[\"cov_hr\"] = fin.sum() / max(1, int(round(w * cfg.hr_grid_hz)))\n    if f[\"cov_hr\"] >= cfg.min_window_coverage and fin.sum() > 2:\n        f[\"hr_mean\"] = float(np.mean(s.hr[fin]))\n        f[\"hr_std\"] = float(np.std(s.hr[fin], ddof=1))\n    if s.beat_t.size > 2:\n        idx = np.flatnonzero((s.beat_t >= t0) & (s.beat_t < t1))\n        if idx.size > 1:\n            pair = idx[1:]\n            pair = pair[s.beat_ok[pair] & s.beat_ok[pair - 1]]\n            if pair.size >= cfg.min_rmssd_pairs:\n                d = (s.ibi[pair] - s.ibi[pair - 1]) * 1000.0\n                f[\"rmssd_ms\"] = float(np.sqrt(np.mean(d ** 2)))\n    ma = (s.acc_t >= t0) & (s.acc_t < t1)\n    f[\"acc_motion\"] = float(np.nanmean(s.acc_dyn[ma])) if ma.any() else np.nan\n    return f\n\n\nprint(\"Signal-processing chain ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:18:20.197006Z","iopub.execute_input":"2026-10-12T18:18:20.197564Z","iopub.status.idle":"2026-10-12T18:18:20.229833Z","shell.execute_reply.started":"2026-10-12T18:18:20.197539Z","shell.execute_reply":"2026-10-12T18:18:20.229041Z"}},"outputs":[{"name":"stdout","text":"Signal-processing chain ready.\n","output_type":"stream"}],"execution_count":9},{"id":"3b760eb5","cell_type":"markdown","source":"## Part C — PhysioNet primary cohort: alignment, quality control and participant-level metrics\n**Time base.** The single E4 tag marks the start of the Working Baseline (t = 0). Phases are then\nRest [−60, 0) s, WB [0, 360), S1 [360, 720), R1 [720, 1080), S2 [1080, 1440), R2 [1440, 1800).\nMATB-II `ELAPSED_TIME` starts at the same task onset. The first 30 s of every phase is treated as a transition and excluded.\n\n**Prespecified metrics** (per signal *m* = tonic EDA, heart rate; *B*, *s* = median and normal-consistent MAD of the\nWorking Baseline, with *s* floored at the cohort 10th percentile to prevent division by near-zero scales):\n* standardised deviation $z(t) = (x(t) - B)/s$\n* reactivity $R$ = mean |z| over Stress 1; recovery burden $RB$ = mean |z| over Recovery 1\n* recovery trajectory = Theil–Sen slope of |z| (30-s bins) across Recovery 1 (negative = returning toward baseline)\n* composite = **geometric mean** of the EDA and HR metrics (both required). Tonic EDA is far smoother than HR, so its\n  |z| values are systematically larger; an arithmetic mean would silently become an EDA-only metric. The geometric\n  mean is scale-invariant, so each signal contributes equally to between-participant variation, and it uses no\n  cohort information (no leakage into the LOSO analyses).\n* composite trajectory = mean of the *relative* slopes (slope ÷ recovery burden, per minute).","metadata":{}},{"id":"357e184a","cell_type":"code","source":"# ── 9 · Load every PhysioNet participant (signals, task logs, demographics) ─\nPHASE_BOUNDS = {\"Rest\": (-cfg.rest_len_s, 0.0)}\nPHASE_BOUNDS.update({ph: (k * cfg.phase_len_s, (k + 1) * cfg.phase_len_s) for k, ph in enumerate(TASK_PHASES)})\nSESSION_LO, SESSION_HI = -cfg.rest_len_s, N_TASK * cfg.phase_len_s\nCROP = (SESSION_LO - 120.0, SESSION_HI + 120.0)          # padding absorbs filter edge effects\n\n\ndef load_physionet_subject(sid: str) -> Tuple[SubjectSignals, Dict]:\n    d = PN_ROOT / \"PPG\" / sid\n    tags = read_e4_tags(d / \"tags.csv\")\n    qc = {\"subject\": sid, \"n_tags\": int(tags.size)}\n    if tags.size == 0:\n        raise DataError(\"no Working-Baseline tag in tags.csv\")\n    ref = float(tags[0])\n    eda_start, eda_fs, eda = read_e4_channel(d / \"EDA.csv\")\n    bvp_start, bvp_fs, bvp = read_e4_channel(d / \"BVP.csv\")\n    acc_start, acc_fs, acc = read_e4_channel(d / \"ACC.csv\")\n    hr_dev = hr_fs = hr_t0 = None\n    if (d / \"HR.csv\").is_file():\n        hr_start, hr_fs, hr_raw = read_e4_channel(d / \"HR.csv\")\n        hr_dev, hr_t0 = hr_raw[:, 0], hr_start - ref\n    qc[\"rec_start_rel_s\"] = eda_start - ref\n    qc[\"rec_end_rel_s\"] = eda_start - ref + eda.shape[0] / eda_fs\n    sig = build_signals(\"PhysioNet\", sid, eda[:, 0], eda_fs, eda_start - ref, bvp[:, 0], bvp_fs, bvp_start - ref,\n                        acc, acc_fs, acc_start - ref, crop=CROP, hr_dev=hr_dev, hr_dev_fs=hr_fs, hr_dev_t0=hr_t0)\n    qc[\"beats_accepted_frac\"] = float(sig.beat_ok.mean()) if sig.beat_ok.size else 0.0\n    return sig, qc\n\n\ndef load_demographics() -> pd.DataFrame:\n    demo = pd.read_csv(PN_ROOT / \"demographicCDrisk.csv\", encoding=\"utf-8-sig\")\n    rename = {}\n    for c in demo.columns:\n        lc = str(c).strip().lower()\n        if \"subject\" in lc:\n            rename[c] = \"subject\"\n        elif \"risc\" in lc:\n            rename[c] = \"cdrisc\"\n        elif lc == \"gender\":\n            rename[c] = \"gender\"\n        elif lc == \"age\":\n            rename[c] = \"age_band\"\n    demo = demo.rename(columns=rename)\n    demo[\"subject\"] = demo[\"subject\"].astype(str).str.strip().str.lower()\n    demo[\"cdrisc\"] = pd.to_numeric(demo.get(\"cdrisc\"), errors=\"coerce\")\n    return demo[[c for c in (\"subject\", \"gender\", \"age_band\", \"cdrisc\") if c in demo.columns]]\n\n\nPN_SIGNALS: Dict[str, SubjectSignals] = {}\nQC_ROWS, MATB_ROWS, MATB_LOGS = [], [], {}\nwith Timer(\"Process PhysioNet participants\"):\n    for sid in PHYSIONET_SUBJECTS:\n        row = {\"subject\": sid}\n        try:\n            sig, qc = load_physionet_subject(sid)\n            PN_SIGNALS[sid] = sig\n            row.update(qc, physio_status=\"ok\")\n        except Exception as exc:\n            row.update(physio_status=f\"excluded: {exc}\")\n            LOG.warning(f\"{sid} physiology excluded — {exc}\")\n        try:\n            log = read_matb(PN_ROOT / \"MATB-II\" / f\"{sid}resman.csv\")\n            MATB_LOGS[sid] = log\n            MATB_ROWS.append({\"subject\": sid, **matb_performance(log)})\n            row[\"matb_status\"] = \"ok\"\n        except Exception as exc:\n            row[\"matb_status\"] = f\"excluded: {exc}\"\n            LOG.warning(f\"{sid} MATB-II excluded — {exc}\")\n        QC_ROWS.append(row)\n\nDEMO = load_demographics()\nMATB = pd.DataFrame(MATB_ROWS)\nLOG.info(f\"Physiology usable: {len(PN_SIGNALS)}/{len(PHYSIONET_SUBJECTS)}  |  MATB-II usable: {len(MATB)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:18:33.348909Z","iopub.execute_input":"2026-10-12T18:18:33.349751Z","iopub.status.idle":"2026-10-12T18:18:35.651023Z","shell.execute_reply.started":"2026-10-12T18:18:33.349724Z","shell.execute_reply":"2026-10-12T18:18:35.650207Z"}},"outputs":[{"name":"stdout","text":"18:18:33 | INFO    | ▶ Process PhysioNet participants\n18:18:35 | INFO    | ■ Process PhysioNet participants — 2.3 s\n18:18:35 | INFO    | Physiology usable: 35/35  |  MATB-II usable: 35\n","output_type":"stream"}],"execution_count":10},{"id":"a1131896","cell_type":"code","source":"# ── 10 · 1-Hz phase-aligned series and participant-level metrics ───────────\nSEC_T = SESSION_LO + np.arange(int(round(SESSION_HI - SESSION_LO))) + 0.5\nHR_PRIMARY, HR_ALT = (\"hr_bvp\", \"hr_e4\") if cfg.hr_source == \"bvp\" else (\"hr_e4\", \"hr_bvp\")\n\n\ndef series_1hz(t: np.ndarray, x: np.ndarray, valid: Optional[np.ndarray] = None) -> np.ndarray:\n    n = SEC_T.size\n    if t is None or x is None or np.size(x) == 0:\n        return np.full(n, np.nan)\n    m = np.isfinite(x)\n    if valid is not None:\n        m &= valid\n    idx = np.floor(np.asarray(t) - SESSION_LO).astype(np.int64)\n    m &= (idx >= 0) & (idx < n)\n    s = np.bincount(idx[m], weights=np.asarray(x)[m], minlength=n)\n    c = np.bincount(idx[m], minlength=n)\n    out = np.full(n, np.nan)\n    out[c > 0] = s[c > 0] / c[c > 0]\n    return out\n\n\ndef phase_mask(phase: str, skip: Optional[float] = None) -> np.ndarray:\n    lo, hi = PHASE_BOUNDS[phase]\n    skip = (0.0 if phase == \"Rest\" else cfg.transition_s) if skip is None else skip\n    return (SEC_T >= lo + skip) & (SEC_T < hi)\n\n\ndef motion_flags(acc: np.ndarray) -> np.ndarray:\n    med, sc = np.nanmedian(acc), robust_scale(acc)\n    if not np.isfinite(sc) or sc == 0:\n        return np.zeros(acc.shape, bool)\n    with np.errstate(invalid=\"ignore\"):\n        return (acc - med) / sc > cfg.motion_robust_z\n\n\nSERIES = {}\nfor sid, sig in PN_SIGNALS.items():\n    SERIES[sid] = {\n        \"eda\": series_1hz(sig.eda_t, sig.eda_tonic, sig.eda_valid),\n        \"hr_bvp\": series_1hz(sig.hr_t, sig.hr),\n        \"hr_e4\": series_1hz(sig.hr_dev_t, sig.hr_dev),\n        \"acc\": series_1hz(sig.acc_t, sig.acc_dyn),\n    }\n\n\ndef reference_stats(x: np.ndarray, ref_phase: str) -> Tuple[float, float, float]:\n    v = x[phase_mask(ref_phase)]\n    cov = float(np.isfinite(v).mean()) if v.size else 0.0\n    if cov < cfg.min_phase_coverage:\n        return np.nan, np.nan, cov\n    return float(np.nanmedian(v)), robust_scale(v), cov\n\n\ndef signal_metrics(x: np.ndarray, ref_phase: str, floor: float) -> Tuple[Dict[str, float], np.ndarray]:\n    B, s, _ = reference_stats(x, ref_phase)\n    out = {\"R\": np.nan, \"RB\": np.nan, \"S2R\": np.nan, \"slope\": np.nan}\n    if not np.isfinite(B):\n        return out, np.full(x.shape, np.nan)\n    s = max(s, floor) if np.isfinite(s) else floor\n    absz = np.abs((x - B) / s)\n    for key, ph in ((\"R\", \"S1\"), (\"RB\", \"R1\"), (\"S2R\", \"S2\")):\n        seg = absz[phase_mask(ph)]\n        out[key] = nanmean_safe(seg) if np.isfinite(seg).mean() >= cfg.min_phase_coverage else np.nan\n    m = phase_mask(\"R1\")\n    seg, tt = absz[m], SEC_T[m]\n    nb = seg.size // cfg.traj_bin_s\n    if nb >= 3:\n        blocks = seg[: nb * cfg.traj_bin_s].reshape(nb, cfg.traj_bin_s)\n        frac = np.isfinite(blocks).mean(axis=1)\n        with warnings.catch_warnings():\n            warnings.simplefilter(\"ignore\", RuntimeWarning)\n            means = np.where(frac >= 0.5, np.nanmean(blocks, axis=1), np.nan)\n        centres = (tt[: nb * cfg.traj_bin_s].reshape(nb, cfg.traj_bin_s).mean(axis=1) - PHASE_BOUNDS[\"R1\"][0]) / 60\n        out[\"slope\"] = theil_slope(centres, means)\n    return out, (x - B) / s\n\n\nVARIANTS = {   # name: (reference phase, HR series, motion filtering)\n    \"\": (\"WB\", HR_PRIMARY, False),          # primary, prespecified\n    \"_rest\": (\"Rest\", HR_PRIMARY, False),   # resting-baseline reference\n    \"_mqc\": (\"WB\", HR_PRIMARY, True),       # motion-artefact-filtered\n    \"_althr\": (\"WB\", HR_ALT, False),        # alternative HR source\n}\nZ_SERIES: Dict[str, Dict[str, np.ndarray]] = {}\nmetric_rows = {sid: {\"subject\": sid} for sid in SERIES}\nSCALE_FLOORS = {}\nfor suffix, (ref_phase, hr_key, use_motion) in VARIANTS.items():\n    sig_map = {\"eda\": \"eda\", \"hr\": hr_key}\n    prepared = {}\n    for sid, ser in SERIES.items():\n        mflag = motion_flags(ser[\"acc\"]) if use_motion else np.zeros(SEC_T.size, bool)\n        prepared[sid] = {k: np.where(mflag, np.nan, ser[v]) for k, v in sig_map.items()}\n    floors = {}\n    for k in sig_map:                                         # pass 1: cohort floor of the baseline scale\n        scales = [reference_stats(prepared[sid][k], ref_phase)[1] for sid in prepared]\n        scales = np.array([s for s in scales if np.isfinite(s) and s > 0])\n        floors[k] = float(np.quantile(scales, cfg.scale_floor_quantile)) if scales.size else 1e-6\n    SCALE_FLOORS[suffix or \"_primary\"] = floors\n    for sid in prepared:                                      # pass 2: participant metrics\n        per_sig = {}\n        for k in sig_map:\n            met, z = signal_metrics(prepared[sid][k], ref_phase, floors[k])\n            per_sig[k] = met\n            for key, val in met.items():\n                metric_rows[sid][f\"{key}_{k}{suffix}\"] = val\n            if suffix == \"\":\n                Z_SERIES.setdefault(sid, {})[k] = z\n        for key in (\"R\", \"RB\", \"S2R\"):                         # scale-invariant equal weighting\n            vals = np.array([per_sig[k][key] for k in sig_map], float)\n            metric_rows[sid][f\"{key}_comp{suffix}\"] = (float(np.exp(np.mean(np.log(np.maximum(vals, 1e-9)))))\n                                                       if np.isfinite(vals).all() else np.nan)\n        rel = np.array([per_sig[k][\"slope\"] / per_sig[k][\"RB\"] if per_sig[k][\"RB\"] > 0 else np.nan\n                        for k in sig_map], float)\n        metric_rows[sid][f\"slope_comp{suffix}\"] = float(rel.mean()) if np.isfinite(rel).all() else np.nan\n\nPART = (pd.DataFrame(list(metric_rows.values()))\n        .merge(MATB, on=\"subject\", how=\"outer\")\n        .merge(DEMO, on=\"subject\", how=\"left\")\n        .sort_values(\"subject\").reset_index(drop=True))\nsave_table(PART, \"participant_level_metrics\")\nLOG.info(f\"Scale floors (cohort {cfg.scale_floor_quantile:.0%} quantile): {SCALE_FLOORS['_primary']}\")\nLOG.info(f\"Complete primary composite (R, RB): {PART[['R_comp', 'RB_comp']].dropna().shape[0]} participants\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:18:45.077661Z","iopub.execute_input":"2026-10-12T18:18:45.078073Z","iopub.status.idle":"2026-10-12T18:18:45.46672Z","shell.execute_reply.started":"2026-10-12T18:18:45.07805Z","shell.execute_reply":"2026-10-12T18:18:45.466129Z"}},"outputs":[{"name":"stdout","text":"18:18:45 | INFO    | table → participant_level_metrics.csv (35 rows)\n18:18:45 | INFO    | Scale floors (cohort 10% quantile): {'eda': 0.0025662881728068937, 'hr': 3.530741651537953}\n18:18:45 | INFO    | Complete primary composite (R, RB): 35 participants\n","output_type":"stream"}],"execution_count":11},{"id":"fba7db0b","cell_type":"code","source":"# ── 11 · Quality-control table, Table 1 and Figure S1 (signal coverage) ─────\nQC = pd.DataFrame(QC_ROWS)\nfor sid in QC[\"subject\"]:\n    if sid not in SERIES:\n        continue\n    for k in (\"eda\", HR_PRIMARY):\n        for ph in [\"Rest\"] + TASK_PHASES:\n            v = SERIES[sid][k][phase_mask(ph)]\n            QC.loc[QC[\"subject\"] == sid, f\"cov_{k}_{ph}\"] = float(np.isfinite(v).mean()) if v.size else np.nan\nsave_table(QC, \"qc_participants\")\n\nt1_rows = [(\"Participants with physiology\", f\"{len(PN_SIGNALS)} / {len(PHYSIONET_SUBJECTS)}\"),\n           (\"Participants with MATB-II logs\", f\"{len(MATB)} / {len(PHYSIONET_SUBJECTS)}\")]\nif \"gender\" in DEMO:\n    t1_rows += [(f\"Gender — {g}\", f\"{n}\") for g, n in DEMO[\"gender\"].value_counts().sort_index().items()]\nif \"age_band\" in DEMO:\n    t1_rows += [(f\"Age band — {a}\", f\"{n}\") for a, n in DEMO[\"age_band\"].value_counts().sort_index().items()]\nif \"cdrisc\" in DEMO:\n    c = DEMO[\"cdrisc\"].dropna()\n    t1_rows.append((\"CD-RISC-10, mean (SD) [range]\", f\"{c.mean():.1f} ({c.std(ddof=1):.1f}) [{c.min():.0f}–{c.max():.0f}]\"))\nfor ph in TASK_PHASES:\n    v = PART[f\"perf_{ph}\"].dropna()\n    t1_rows.append((f\"RESMAN error, {ph}: median [IQR]\",\n                    f\"{v.median():.1f} [{v.quantile(.25):.1f}–{v.quantile(.75):.1f}]\"))\nTABLE1 = pd.DataFrame(t1_rows, columns=[\"Characteristic\", \"Value\"])\nsave_table(TABLE1, \"table1_cohort\")\ntry:\n    display(TABLE1)          # rich table inside Jupyter/Kaggle\nexcept NameError:\n    print(TABLE1.to_string(index=False))\n\ncov_cols = [c for c in QC.columns if c.startswith(\"cov_\")]\nif cov_cols:\n    covmat = QC.set_index(\"subject\")[cov_cols].astype(float)\n    fig, ax = plt.subplots(figsize=(COL2, max(2.6, 0.085 * len(covmat) + 0.9)), layout=\"constrained\")\n    im = ax.imsh