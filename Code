 3.6), sharex=True, layout=\"constrained\")\n    for ax, (k, ylabel, col) in zip(axes, [(\"eda\", \"Tonic EDA (baseline z)\", OI[\"vermillion\"]),\n                                            (\"hr\", \"Heart rate (baseline z)\", OI[\"blue\"])]):\n        mat = np.vstack([Z_SERIES[s][k] for s in Z_SERIES if k in Z_SERIES[s]])\n        mu, lo, hi, n = cohort_band(mat)\n        shade_phases(ax, label=(k == \"eda\"))\n        ax.fill_between(SEC_T / 60, lo, hi, color=col, alpha=0.25, lw=0, zorder=2)\n        ax.plot(SEC_T / 60, mu, color=col, lw=1.1, zorder=3)\n        ax.set_ylabel(ylabel)\n        ax.set_xlim(SESSION_LO / 60, SESSION_HI / 60)\n        ax.text(0.995, 0.95, f\"n = {int(np.nanmax(n))}\", transform=ax.transAxes, ha=\"right\", va=\"top\", fontsize=6)\n    axes[-1].set_xlabel(\"Time from task onset (min)\")\n    axes[-1].set_xticks(np.arange(0, 31, 6))\n    label_panels(fig, axes)\n    save_fig(fig, \"fig1_physiological_trajectories\",\n             \"Figure 1. Cohort-mean deviation from each participant's Working-Baseline reference (robust z; 15-s moving \"\n             \"average) for (a) tonic EDA and (b) BVP-derived heart rate. Bands: 95% CI across participants. \"\n             \"Shading: grey = working baseline, orange = stress (RESMAN + COMMS), blue = recovery (RESMAN only).\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:19:32.494467Z","iopub.execute_input":"2026-10-12T18:19:32.495288Z","iopub.status.idle":"2026-10-12T18:19:33.764831Z","shell.execute_reply.started":"2026-10-12T18:19:32.495263Z","shell.execute_reply":"2026-10-12T18:19:33.764038Z"}},"outputs":[{"name":"stdout","text":"18:19:33 | INFO    | figure → fig1_physiological_trajectories (png, pdf @ 600 dpi)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 792.52x396 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":13},{"id":"a3aa362d","cell_type":"code","source":"# ── 13 · Figure 2 — RESMAN task performance by phase ────────────────────────\nperf_cols = [f\"perf_{ph}\" for ph in TASK_PHASES]\nperf = PART[[\"subject\"] + perf_cols].dropna()\nif len(perf) >= 5:\n    fr = stats.friedmanchisquare(*[perf[c] for c in perf_cols])\n    w12 = stats.wilcoxon(perf[\"perf_S1\"], perf[\"perf_S2\"])\n    kendall_w = fr.statistic / (len(perf) * (N_TASK - 1))\n    RESULTS[\"performance\"] = {\"n\": int(len(perf)), \"friedman_chi2\": float(fr.statistic), \"friedman_p\": float(fr.pvalue),\n                              \"kendall_W\": float(kendall_w), \"wilcoxon_S1_vs_S2_p\": float(w12.pvalue),\n                              \"median_by_phase\": {c: float(perf[c].median()) for c in perf_cols}}\n    fig, ax = plt.subplots(figsize=(COL1, 2.6), layout=\"constrained\")\n    xs = np.arange(N_TASK)\n    for _, r in perf.iterrows():\n        ax.plot(xs, r[perf_cols].to_numpy(float), color=\"#B0B0B0\", lw=0.35, alpha=0.6, zorder=1)\n    bp = ax.boxplot([perf[c] for c in perf_cols], positions=xs, widths=0.45, showfliers=False, patch_artist=True,\n                    medianprops=dict(color=\"black\", lw=1.0), whiskerprops=dict(lw=0.6), capprops=dict(lw=0.6),\n                    boxprops=dict(lw=0.6), zorder=2)\n    for patch, ph in zip(bp[\"boxes\"], TASK_PHASES):\n        patch.set_facecolor(PHASE_FILL[ph])\n    jit = rng_for(\"fig2\").uniform(-0.12, 0.12, size=(len(perf), N_TASK))\n    for j, (c, ph) in enumerate(zip(perf_cols, TASK_PHASES)):\n        ax.scatter(xs[j] + jit[:, j], perf[c], s=5, color=PHASE_DOT[ph], alpha=0.85, lw=0, zorder=3)\n    ax.set_xticks(xs, [PHASE_LABEL[p] for p in TASK_PHASES])\n    ax.set_ylabel(\"RESMAN error (fuel units, mean |Δ|)\")\n    ax.set_ylim(top=perf[perf_cols].to_numpy().max() * 1.14)\n    ax.text(0.02, 0.98, f\"Friedman χ²({N_TASK - 1}) = {fr.statistic:.1f}, {fmt_p(fr.pvalue)}; W = {kendall_w:.2f}\",\n            transform=ax.transAxes, va=\"top\", fontsize=6)\n    save_fig(fig, \"fig2_task_performance\",\n             f\"Figure 2. Mean absolute deviation of tanks A and B from the 2,500-unit target in each phase (n = {len(perf)}). \"\n             \"Grey lines connect each participant; boxes show median and IQR.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:19:46.178215Z","iopub.execute_input":"2026-10-12T18:19:46.179064Z","iopub.status.idle":"2026-10-12T18:19:46.958297Z","shell.execute_reply.started":"2026-10-12T18:19:46.179031Z","shell.execute_reply":"2026-10-12T18:19:46.957531Z"}},"outputs":[{"name":"stdout","text":"18:19:46 | INFO    | figure → fig2_task_performance (png, pdf @ 600 dpi)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 385.433x286 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"id":"5702a75f","cell_type":"markdown","source":"## RQ1 — Is recovery burden associated with subsequent task performance?\nPrespecified model (all variables standardised, HC3 heteroskedasticity-consistent errors):\n\n$\\text{Error}_{S2} = \\beta_0 + \\beta_1\\,\\text{Error}_{WB} + \\beta_2\\,\\text{Error}_{S1} + \\beta_3\\,R + \\beta_4\\,RB + \\varepsilon$\n\nThe parameter of interest is $\\beta_4$. A participant bootstrap gives a second CI that does not rely on normal theory.\nThis is an associational analysis; it cannot establish that incomplete recovery *causes* poorer performance.","metadata":{}},{"id":"7fed2d12","cell_type":"code","source":"# ── 14 · RQ1 primary model, bootstrap and diagnostics ──────────────────────\nRQ1_Y, RQ1_X, RQ1_TARGET = \"perf_S2\", [\"perf_WB\", \"perf_S1\", \"R_comp\", \"RB_comp\"], \"RB_comp\"\nX_LABEL = {\"perf_WB\": \"WB error\", \"perf_S1\": \"Stress-1 error\", \"R_comp\": \"Reactivity (S1)\",\n           \"RB_comp\": \"Recovery burden (R1)\"}\n\n\ndef standardized_fit(df: pd.DataFrame, y: str, xs: List[str], model: str = \"ols\"):\n    d = df[[y] + xs].apply(pd.to_numeric, errors=\"coerce\").dropna()\n    if len(d) < len(xs) + 5:\n        raise DataError(f\"only {len(d)} complete participants for {len(xs)} predictors\")\n    sd = d.std(ddof=1)\n    if (sd == 0).any():\n        raise DataError(f\"zero variance in {list(sd[sd == 0].index)}\")\n    z = (d - d.mean()) / sd\n    X = sm.add_constant(z[xs], has_constant=\"add\")\n    fit = (sm.OLS(z[y], X).fit(cov_type=\"HC3\") if model == \"ols\"\n           else sm.RLM(z[y], X, M=sm.robust.norms.HuberT()).fit())\n    return fit, d, z\n\n\ndef coef_frame(fit, xs: List[str]) -> pd.DataFrame:\n    ci = fit.conf_int()\n    return pd.DataFrame({\"term\": xs, \"beta\": fit.params[xs].to_numpy(), \"se\": fit.bse[xs].to_numpy(),\n                         \"ci_low\": ci.loc[xs, 0].to_numpy(), \"ci_high\": ci.loc[xs, 1].to_numpy(),\n                         \"p\": fit.pvalues[xs].to_numpy()})\n\n\ndef bootstrap_std_beta(d: pd.DataFrame, y: str, xs: List[str], target: str, n_boot: int, tag: str) -> np.ndarray:\n    Y, X = d[y].to_numpy(float), d[xs].to_numpy(float)\n    n, j = len(Y), xs.index(target)\n    rng = rng_for(tag)\n    out = np.full(n_boot, np.nan)\n    for b in range(n_boot):\n        idx = rng.integers(0, n, n)\n        Yb, Xb = Y[idx], X[idx]\n        sy, sx = Yb.std(ddof=1), Xb.std(axis=0, ddof=1)\n        if sy == 0 or np.any(sx == 0):\n            continue\n        A = np.column_stack([np.ones(n), (Xb - Xb.mean(0)) / sx])\n        out[b] = np.linalg.lstsq(A, (Yb - Yb.mean()) / sy, rcond=None)[0][1 + j]\n    return out\n\n\nRQ1 = {}\ntry:\n    fit1, d1, z1 = standardized_fit(PART, RQ1_Y, RQ1_X)\n    coefs = coef_frame(fit1, RQ1_X)\n    boot = bootstrap_std_beta(d1, RQ1_Y, RQ1_X, RQ1_TARGET, cfg.n_boot, \"rq1_boot\")\n    blo, bhi = pct_ci(boot)\n    raw_fit = sm.OLS(d1[RQ1_Y], sm.add_constant(d1[RQ1_X])).fit(cov_type=\"HC3\")\n    ols_plain = sm.OLS(z1[RQ1_Y], sm.add_constant(z1[RQ1_X])).fit()\n    cooks = ols_plain.get_influence().cooks_distance[0]\n    vif = {x: float(variance_inflation_factor(sm.add_constant(z1[RQ1_X]).to_numpy(), i + 1))\n           for i, x in enumerate(RQ1_X)}\n    bp_p = float(het_breuschpagan(ols_plain.resid, ols_plain.model.exog)[1])\n    sw_p = float(stats.shapiro(ols_plain.resid)[1])\n    coefs[\"boot_ci_low\"] = np.where(coefs[\"term\"] == RQ1_TARGET, blo, np.nan)\n    coefs[\"boot_ci_high\"] = np.where(coefs[\"term\"] == RQ1_TARGET, bhi, np.nan)\n    coefs[\"vif\"] = coefs[\"term\"].map(vif)\n    save_table(coefs, \"rq1_primary_coefficients\")\n    b4 = coefs.set_index(\"term\").loc[RQ1_TARGET]\n    RQ1 = {\"n\": int(len(d1)), \"beta_RB\": float(b4[\"beta\"]), \"ci_HC3\": [float(b4[\"ci_low\"]), float(b4[\"ci_high\"])],\n           \"p_HC3\": float(b4[\"p\"]), \"ci_bootstrap\": [blo, bhi], \"R2\": float(ols_plain.rsquared),\n           \"adj_R2\": float(ols_plain.rsquared_adj), \"raw_beta_RB_fuel_units_per_z\": float(raw_fit.params[RQ1_TARGET]),\n           \"max_VIF\": float(max(vif.values())), \"breusch_pagan_p\": bp_p, \"shapiro_resid_p\": sw_p,\n           \"n_cooks_gt_4_over_n\": int((cooks > 4 / len(d1)).sum())}\n    RESULTS[\"RQ1\"] = RQ1\n    LOG.info(f\"RQ1 (n={RQ1['n']}): standardised β_RB = {fmt_ci(RQ1['beta_RB'], *RQ1['ci_HC3'])} (HC3), \"\n             f\"{fmt_p(RQ1['p_HC3'])}; bootstrap CI [{blo:.2f}, {bhi:.2f}]; R² = {RQ1['R2']:.2f}; \"\n             f\"max VIF = {RQ1['max_VIF']:.2f}\")\n    print(coefs.round(3).to_string(index=False))\nexcept DataError as exc:\n    LOG.error(f\"RQ1 primary model not estimable: {exc}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T18:20:08.129184Z","iopub.execute_input":"2026-10-12T18:20:08.129612Z","iopub.status.idle":"2026-10-12T18:20:09.00567Z","shell.execute_reply.started":"2026-10-12T18:20:08.129586Z","shell.execute_reply":"2026-10-12T18:20:09.005064Z"}},"outputs":[{"name":"stdout","text":"18:20:08 | INFO    | table → rq1_primary_coefficients.csv (4 rows)\n18:20:08 | INFO    | RQ1 (n=35): standardised β_RB = 0.04 [-0.44, 0.53] (HC3), p = 0.865; bootstrap CI [-0.43, 0.43]; R² = 0.80; max VIF = 3.93\n   term   beta    se  ci_low  ci_high     p  b